* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  body {
    font-family: 'Segoe UI', sans-serif;
    background-color: #fffaf0;
    color: #232222;
    line-height: 1.6;
  }
  
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #710101;
    color: white;
    padding: 20px 40px;
    
  }
  
  .logo h1 {
    margin: 0;
  }
  
  .navbar a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
  }
  
  .navbar a:hover {
    text-decoration:underline;
  }
  
  .class {
    background-image: url('cb.png');
    background-size: cover;
    background-position: center;
    color: white;
    padding: 100px 20px;
    text-align: center;
    position: relative;
  }
  
  .class-layout {
    background-color: rgba(0, 0, 0, 0.5);
    padding: 60px 20px;
    border-radius: 10px;
    display: inline-block;
  }
  
  .class h2 {
    font-size: 2.5em;
    margin-bottom: 10px;
  }
  
  .class-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 25px;
    background-color: #710000;
    color: white;
    border-radius: 5px;
    text-decoration: none;
  }
  
  .class-btn:hover {
    background-color: #a52a2a;
  }
  
  
  .about {
    padding: 40px 20px;
    max-width: 800px;
    margin: auto;
    text-align: center;
  }
  

  .featured {
    background-color: #fffaf0;
    padding: 40px 20px;
    max-width: 1000px;
    margin: auto;
  }
  
  .featured h2 {
    text-align: center;
    margin-bottom: 30px;
  }
  
  .dish-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
  }
  
  .dish-card {
    background-color: white;
    padding: 20px;
    width: 250px;
    border-left: 5px solid #8b0000;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(57, 55, 55, 0.933);
    text-align: center;
  }
  
  .dish-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 5px;
    margin-bottom: 10px;
  }
  .contact {
    max-width: 600px;
    margin: 40px auto;
    padding: 20px;
  }
  
  .contact form {
    display: flex;
    flex-direction: column;
  }
  
  .contact label {
    margin-top: 10px;
    font-weight: bold;
  }
  
  .contact input,
  .contact textarea {
    padding: 10px;
    margin-top: 5px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }
  
  .contact button {
    margin-top: 20px;
    padding: 10px;
    background-color: #8b0000;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
  }
  
  .contact button:hover {
    background-color: #a52a2a;
  }
  
 
 
  footer {
    background-color: #eeeeee;
    padding: 20px;
    text-align: center;
    margin-top: 40px;
    font-size: 0.9em;
  }
  

  @media (max-width: 768px) {
    .dish-list {
      flex-direction: column;
      align-items: center;
    }
  
    .header {
      flex-direction: column;
      text-align: center;
    }
  
    .navbar {
      margin-top: 10px;
    }
  }
  

.menu-page {
    padding: 40px 20px;
    max-width: 1000px;
    margin: auto;
  }
  
  .menu-page h2 {
    text-align: center;
    margin-bottom: 40px;
    font-size: 2em;
  }
  
  .menu-section {
    margin-bottom: 50px;
  }
  
  .menu-section h3 {
    color: #8b0000;
    margin-bottom: 20px;
    border-left: 5px solid #8b0000;
    padding-left: 10px;
  }
  
  .menu-items {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }
  
  .menu-card {
    background-color: #fff;
    border-radius: 8px;
    width: 200px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    text-align: center;
    padding: 15px;
  }
  
  .menu-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 5px;
    margin-bottom: 10px;
  }
  
  .menu-card h4 {
    margin: 10px 0 5px;
    font-size: 1.1em;
  }
  
  .menu-card p {
    font-size: 0.95em;
    color: #444;
  }
  
